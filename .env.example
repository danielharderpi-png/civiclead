# CivicLead Engine — Optional Environment Configuration
# Running locally does NOT require a .env file; providers & keys can be
# configured directly in the UI ("Configure AI Engine" / "Search API") and
# stored locally in SQLite (./data/civiclead.db) and user-settings.json.

# Server bind address & port (defaults to loopback 127.0.0.1:3000)
PORT=3000
HOST=127.0.0.1

# Optional public origin if hosted behind a reverse proxy (used by CSRF guard)
APP_URL="http://localhost:3000"

# Optional AI provider API key fallbacks (leave blank if using Manual Batch or Local LLM)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional Search API key fallbacks (leave blank to use the $0.00 built-in scraper)
SERPER_API_KEY=""
BRAVE_API_KEY=""
TAVILY_API_KEY=""
